{
	"schemaVersion": 1,
	"id": "aeriscard",
	"version": "${version}",
	"name": "AerisCard",
	"description": "A Fabric mod that recreates Valorant's Aeris Flex in Minecraft.The original is in Valorant!",
	"authors": [
		"🤔크리펑🤔"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/aeriscard/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["com.aeriscard.AerisCardMod"],
		"client": ["com.aeriscard.client.AerisCardClient"]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"geckolib": "*"
	},
	"mixins": [
		{
			"config": "aeriscard.client.mixins.json",
			"environment": "client"
		}
	]
}